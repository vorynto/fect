Options -MultiViews
RewriteEngine On

# Handle HTTPS redirect
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# SPA fallback — send all non-file requests to THIS folder's index.html.
# Relative target so it works whether the web root is the repo root
# (requests forwarded into /dist) or /dist itself.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [L]
