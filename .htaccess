Options -MultiViews
RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Serve the built app from /dist while the web root stays at the repo root.
# Everything is handed to /dist; dist/.htaccess serves real files and falls
# back to dist/index.html for SPA routes (e.g. /admin/login, /donate).
# No %{DOCUMENT_ROOT} checks — that variable is unreliable on Hostinger subdomains.

# 1. Already inside /dist — stop here (prevents rewrite loops)
RewriteRule ^dist/ - [L]

# 2. Hand every other request to /dist
RewriteRule ^(.*)$ dist/$1 [L]
